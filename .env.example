# ============================================================
# NOE + ARCA KIDS - environment variables (template)
# ============================================================
# Copy this file to each location that needs a real .env:
#   - apps/noe/.env
#   - apps/arcakids/.env
# Never commit real values. Use the anon/public key only.
#
# Both apps share the same Supabase project.
# EXPO_PUBLIC_* variables are inlined by Expo at build time.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=