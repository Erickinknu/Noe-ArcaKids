# ARCA KIDS - environment template.
# Copy to apps/arcakids/.env with real values (never commit real values).
# Both apps share the same Supabase project. Anon/public key only.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# App environment: development | staging | production (off for release builds).
EXPO_PUBLIC_APP_ENV=development

# Sentry (optional until a project is created). Set in EAS secrets for production builds.
EXPO_PUBLIC_SENTRY_DSN=
# Used only to enable the Sentry Expo config plugin during EAS builds (set as EAS secrets):
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=